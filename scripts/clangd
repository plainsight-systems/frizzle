#!/usr/bin/env python3
"""Editor adapter: starts the same pinned LLVM's clangd that checks use for clang-tidy and clang-format."""
import os
import sys
from tooling import find_tool

try:
    binary = find_tool('clangd')
    os.execv(binary, [binary, *sys.argv[1:]])
except (OSError, ValueError) as error:
    print(f'clangd: {error}', file=sys.stderr)
    sys.exit(2)
