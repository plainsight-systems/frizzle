// The page: React, the browser's DOM. protocol/ and engine/ join when their
// first modules land (slice 3, step 4); the worker has its own project
// (tsconfig.worker.json).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src/main.tsx", "src/App.tsx"]
}
