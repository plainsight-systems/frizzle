// The page: React, the browser's DOM, and the protocol and edit types it
// shares with the worker, which has its own project (tsconfig.worker.json).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/protocol/**/*.ts",
    "src/engine/**/*.ts"
  ]
}
