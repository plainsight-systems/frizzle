{
  "name": "frizzle-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.page.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p ../tests/integration/browser/tsconfig.json",
    "format": "prettier --write src index.html vite.config.ts ../tests/contracts ../tests/support ../tests/integration/browser/*.ts",
    "format:check": "prettier --check src index.html vite.config.ts ../tests/contracts ../tests/support ../tests/integration/browser/*.ts"
  },
  "dependencies": {
    "@huggingface/jinja": "0.5.10",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
