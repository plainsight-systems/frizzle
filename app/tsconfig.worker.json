// The engine's worker: the Web Worker's types, not the DOM's, so worker code
// cannot reach for the page's globals. protocol/ and engine/ join when their
// first modules land (slice 3, step 4).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "types": []
  },
  "include": ["src/worker/**/*.ts"]
}
